# Dependencies
**/node_modules/

# Local environment variables and secrets
.env
.env.*
!.env.example
!**/.env.example

# Build output and caches
**/dist/
**/build/
**/coverage/
**/.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Uploaded recordings and private media
backend/uploads/*
!backend/uploads/.gitkeep
recordings/
**/*.mp3
**/*.wav
**/*.m4a
**/*.aac
**/*.ogg
**/*.webm

# Local/editor/OS files
*.local
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Frontend environment variables
frontend/.env
frontend/.env.*
!frontend/.env.example

# Backend environment variables
backend/.env
backend/.env.*
!backend/.env.example

# Python virtual environments (future AI service)
venv/
.venv/
__pycache__/
*.pyc

# IDE settings
.vscode/*
!.vscode/extensions.json